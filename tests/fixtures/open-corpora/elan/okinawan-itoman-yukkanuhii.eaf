    <TIER ANNOTATOR="Kato Kanji" LINGUISTIC_TYPE_REF="transcription" PARENT_REF="reference_no@HM" PARTICIPANT="Hideo Miyagi" TIER_ID="transcription@HM">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>ee kuuja nisenzjuukjuunen rokugacuni hazimataru jukkanuhiinu ee ugwannu hanasii sabira</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>itjimannu mannakankaija santinmoonri iiru ee jamaga aibiin</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>itjimannu santinmooja ee ugwandukuman jakutu nmanzi jukkanuhiija asanu ugwankara hazimain</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a69" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>jukkanuhiinu asaja ee itjimannu kamintjutuka nanzan uuzatunu kamintjuga atjimati mazjee haareenu ee ugankara hazimi jan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>un haareenu ugwannee nanzannu nurun kawainkai ee jamagaa nurunu kawainkai eeto santinri iiru ugami saaga kuukutu uritu itjimanzji haareenu hata huiru tukujaanu jaagunaga nmankaija atjimatoon</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a103" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>mata unu hukankai kaku muntjuunu eeto sinkan ugaminkai tjookutu nnasaama kuuja jukkanuhii janroonri ugan kaki jabiin</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a127" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>jukkanuhiinu ugwanga uwainee nnatunzi mattjooru ee haareebunin sinkankai haaree hazimainroonri iiru eezi suru hatagajaa tukujaanri iiru ujaanu ee nuusinkai hata huiru ee aizuga sabiin</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a128" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>un eezjee hatawa agiinee [...] un hata saama ee jukkanuhiinu uganbaariinu uganbaareenu ee eezi natookutu un hatanzi jaama haareesinkaja uganbaaree kuugi hazimiinri irattoon</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        </TIER>
