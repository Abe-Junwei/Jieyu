    <TIER ANNOTATOR="Kato Kanji" LINGUISTIC_TYPE_REF="translation" PARENT_REF="transcription@HM" PARTICIPANT="Hideo Miyagi" TIER_ID="translation@HM">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>今日は2019年6月に始まったユッカヌヒーの拝みの話をしましょう。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>糸満の真ん中には山巓毛という山があります。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a74" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>糸満の山巓毛は礼拝所でもあるので、そこでユッカヌヒーは拝みから始まる。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>ユッカヌヒーの朝は糸満のカミンチュや南山大里のカミンチュが集まってまずはハーレーの拝みから始める。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>ハーレーの拝みは、南山のノロの代わりに、山川ノロの代わりに、サンティンという拝みをする人が来るので、その人とハーレーの旗を振る徳屋の家族がそこに集まっている。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a107" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>またその他に各門中の人々も拝みに来ているので、みんなで今日はユッカヌヒーだと言って拝みをします。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a131" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>ユッカヌヒーの拝みが終わったら、港で待っているハーレー船の漕ぎ手に向かって「始まるよ」という合図をする旗が、徳屋という門中の宗家の当主が旗を振る合図が行われます。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a132" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>その合図の旗が上がったら、ユッカヌヒーのウグヮンバーレーの（始まる）合図なので、その旗によってハーレーの漕ぎ手が漕ぎ始めると言われている。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        </TIER>
    <TIER ANNOTATOR="Kato Kanji" LINGUISTIC_TYPE_REF="segmentation" PARENT_REF="transcription@HM" PARTICIPANT="Hideo Miyagi" TIER_ID="segmentation@HM">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>kuu^N =ja nisenzjuukjuu -nen roku -gacu =ni hazima- -ta- -ru jukkanuhii =nu2 ee ugwan =nu2 hanasii s- -abi- -ra</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>itjiman =nu2 mannaka =nkai =ja santinmoo =nri i- -i- -ru jama =ga1 a- -abi- -i- -n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a77" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>itjiman =nu2 santinmoo =ja ugwan +tukuma =n1 ja- -kutu nma =nzi jukkanuhii =ja asa =nu2 ugwan =kara hazima- -i- -n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>jukkanuhii =nu2 asa =ja itjiman =nu2 kamintju =tuka nanzan uuzatu =nu2 kamintju =ga1 atjima- -ti mazu =ja haaree =nu2 ugan =kara hazim- -i ja- -n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a79" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>un^D haaree =nu2 ugwan =ni =ja nanzan =nu2 nuru =n2 kawai =nkai jamagaa +nuru =nu2 kawai =nkai santin =nri i- -i- -ru ugami s- -aa =ga1 kuu-^V -kutu uri =tu itjiman =nzi haaree =nu2 hata hu- -i- -ru tukujaa =nu2 jaaguna =ga1 nma =nkai =ja atjima- -too- -n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a109" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>mata unu huka =nkai kaku muntjuu =nu2 sinka =n1 ugami =nkai tjoo- -kutu nna =saama kuu^N =ja jukkanuhii ja- -n =roo =nri ugan kak- -i ja- -abi- -i- -n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a133" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>jukkanuhii =nu2 ugwan =ga1 uwa- -inee nnatu =nzi mat- -too- -ru haaree +huni =n2 sinka =nkai haaree hazima- -i- -n =roo =nri i- -i- -ru eezi su- -ru hata =ga1 =jaa tukujaa =nri i- -i- -ru ujaa =nu2 ee nuusi =nkai hata hu- -i- -ru aizu =ga1 s- -abi- -i- -n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a134" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>un^D eezi =ja hata =wa agi- -inee un^D hata s- -aama jukkanuhii =nu2 uganbaarii =nu2 uganbaaree =nu2 eezi na- -too- -kutu un^D hata =nzi ja- -aama haaree +sinka =ja uganbaaree kuug- -i hazimi- -i- -n =nri i- -rar- -too- -n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        </TIER>
