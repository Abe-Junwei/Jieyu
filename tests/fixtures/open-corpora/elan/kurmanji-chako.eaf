		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a640" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts6">
				<ANNOTATION_VALUE>Carê</ANNOTATION_VALUE>
			</ALIGNABLE_ANNOTATION>
		</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a641" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts10">
				<ANNOTATION_VALUE>hebû</ANNOTATION_VALUE>
			</ALIGNABLE_ANNOTATION>
		</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a642" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts16">
				<ANNOTATION_VALUE>tûnebû</ANNOTATION_VALUE>
			</ALIGNABLE_ANNOTATION>
		</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a643" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts17">
				<ANNOTATION_VALUE>&lt;p:&gt;</ANNOTATION_VALUE>
			</ALIGNABLE_ANNOTATION>
