{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/pre-tool-protect-generated.mjs",
        "matcher": "Write",
        "timeout": 15
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/after-file-edit-format.mjs",
        "matcher": "Write|TabWrite",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop-verify.mjs",
        "timeout": 300,
        "loop_limit": 2
      }
    ]
  }
}
