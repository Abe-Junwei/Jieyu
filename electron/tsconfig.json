{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "~/*": ["../src/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.d.ts", "../src/desktop/skeleton/**/*.ts"],
  "exclude": [
    "../src/desktop/skeleton/**/*.test.ts",
    "../src/desktop/skeleton/sqliteStorageHost.ts",
    "dist"
  ]
}
